rules_version = '2';

// StockPro Firestore Security Rules (architecture.md §5.2)
// Clients are READ-ONLY. All writes go through Cloud Functions.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──

    function isAuthenticated() {
      return request.auth != null;
    }

    function belongsToOrg(orgId) {
      return isAuthenticated()
          && request.auth.token.orgId == orgId;
    }

    function hasAnyRoleInPlant(orgId, plantId) {
      return belongsToOrg(orgId)
          && plantId in request.auth.token.plantRoles;
    }

    // ── Organization root ──

    match /organizations/{orgId} {
      allow read: if belongsToOrg(orgId);
      allow write: if false;  // functions only

      // Members subcollection
      match /members/{uid} {
        allow read: if belongsToOrg(orgId);
        allow write: if false;
      }

      // Audit events
      match /auditEvents/{eventId} {
        allow read: if belongsToOrg(orgId);
        allow write: if false;
      }

      // ── Plant-scoped data ──

      match /plants/{plantId} {
        allow read: if hasAnyRoleInPlant(orgId, plantId);
        allow write: if false;

        // All plant subcollections — read-only for authorised users
        match /{collection}/{docId} {
          allow read: if hasAnyRoleInPlant(orgId, plantId);
          allow write: if false;
        }

        // Nested subcollections (e.g., items/{itemId}/*)
        match /{collection}/{docId}/{subCollection}/{subDocId} {
          allow read: if hasAnyRoleInPlant(orgId, plantId);
          allow write: if false;
        }
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
